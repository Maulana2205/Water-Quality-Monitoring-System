# MQTT over WSS (read-only dashboard credential — safe to expose in bundle)
VITE_MQTT_BROKER_URL=wss://YOUR_DEPLOYMENT.ala.asia-southeast1.emqxsl.com:8084/mqtt
VITE_DEVICE_ID=esp32_water_01
# Kredensial read-only dashboard (tidak boleh publish). Buat di EMQX Cloud ACL.
VITE_MQTT_USER=YOUR_READ_ONLY_USERNAME
VITE_MQTT_PASS=YOUR_READ_ONLY_PASSWORD
