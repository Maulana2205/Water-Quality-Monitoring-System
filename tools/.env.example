# Contoh file environment untuk tools/simulate_device.mjs
# Salin ke tools/.env dan isi dengan nilai asli dari console EMQX Cloud Anda.
# JANGAN commit tools/.env (berisi kredensial nyata) — sudah di .gitignore.

# WSS endpoint dari console EMQX Cloud (:8084/mqtt)
SIM_MQTT_URL=wss://<host-emqx>:8084/mqtt

# Username device dari EMQX (ACL: publish water_quality/<device_id>/#)
SIM_MQTT_USER=device_esp32_01

# Password device dari EMQX
SIM_MQTT_PASS=<password-anda>

# Device ID yang dipublish (default cocok dengan ACL di atas)
SIM_DEVICE_ID=esp32_water_01

# QoS publish (0 atau 1)
SIM_QOS=0

# Retained message (true/false)
SIM_RETAIN=true
